import("//build/templates/build_template.gni")
import("//build/toolchain/blueos.gni")

declare_args() {
  # Filter miri tests to a single case; empty means run all tests.
  # Override with single `test_strlen` testcase via:
  # `gn gen out/none --args='board="none" miri_test_case="test_strlen"'`
  # or `make miri_test CASE=test_strlen`
  miri_test_case = ""
  # Extra flags of miri or rustc.
  # e.g. miri_flags=["-Aunsafe_op_in_unsafe_fn", "-Aunused"]
  miri_flags = []
}

group("check_infra") {
  testonly = true
  deps = [ ":run_infra_unittest" ]
}

group("check_infra_by_miri") {
  testonly = true
  deps = [ ":infra_miri_test" ]
}

group("check_infra_by_clippy") {
  testonly = true
  deps = [
    ":blueos_infra_clippy",
    ":infra_unittest_clippy",
  ]
}

shared_deps = [
  "//external/vendor/cfg-if-1.0.4:cfg_if",
  "//external/vendor/memchr-2.7.6:memchr",
  "//external/vendor/spin-0.9.8:spin",
]

build_rust("blueos_infra") {
  crate_type = "rlib"
  sources = [ "src/lib.rs" ]
  edition = "2021"
  deps = shared_deps
}

run_clippy("blueos_infra_clippy") {
  deps = [ ":blueos_infra" ]
}

miri_test("infra_miri_test") {
  crate = "src/lib.rs"
  deps = [ ":blueos_infra" ]

  test_name = miri_test_case
  extra_miri_flags = miri_flags
  extra_miri_flags += [
    "-Aunsafe_op_in_unsafe_fn", "-Aunused",
    # "-Zmiri-tree-borrows", # use tree borrow model
    # "-Zmiri-preemption-rate=0.01", # controls how often Miri forces a thread context switch during scheduling.
    # more miri flags...
  ]
}

build_rust("infra_unittest") {
  testonly = true
  crate_name = "infra_unittest"
  crate_type = "bin"
  sources = [ "src/lib.rs" ]
  edition = "2021"

  deps = shared_deps
  rustflags = [ "--test" ]
}

run_clippy("infra_unittest_clippy") {
  testonly = true
  deps = [ ":infra_unittest" ]
}

run_host("run_infra_unittest") {
  testonly = true
  runner = ":infra_unittest"
}
