{
  "arch": "riscv64",
  "code-model": "medium",
  "cpu": "generic-rv64",
  "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
  "dynamic-linking": true,
  "eh-frame-header": false,
  "emit-debug-gdb-scripts": false,
  "env": "newlib",
  "target-family": ["unix"],
  "features": "+m,+a,+c",
  "linker": "rust-lld",
  "linker-flavor": "gnu-lld",
  "llvm-abiname": "lp64",
  "llvm-target": "riscv64",
  "max-atomic-width": 64,
  "os": "blueos",
  "panic-strategy": "abort",
  "relocation-model": "pic",
  "supported-sanitizers": ["shadow-call-stack", "kernel-address"],
  "target-pointer-width": 64,
  "tls-model": "emulated",
  "vendor": "vivo"
}
