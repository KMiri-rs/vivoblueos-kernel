import("//build/templates/board.gni")

blueos_board("kmiri") {
  kernel_config = {
    rustflags = [
      "--cfg",
      "target_board=\"kmiri\"",
    ]
  }

  app_config = {
    rustflags = [
      "--cfg",
      "target_board=\"kmiri\"",
    ]
  }

  default = []

  # Building the unit test kernel in the Miri toolchain interprets it.
  check_all = [ "//kernel/kernel:kernel_unittest" ]
}
